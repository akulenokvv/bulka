// Задание 7
double sred_znach(double months[12]) {
    double sum = 0.0;
    for (int i = 0; i < 12; i++) {
        sum += months[i];
    }
    return sum / 12.0;
}
double random_temp(double min, double max) {
    return min + (rand() / (RAND_MAX + 1.0)) * (max - min);
}
int main() {
    srand(time(0));
    const char* islands[4] = { "Kuba", "Trinidad", "Yamaika", "Gaiti" };
    double min_t[4] = { 24.0, 25.0, 23.0, 22.0 };
    double max_t[4] = { 31.0, 30.0, 29.0, 28.0 };
    double temp[4][12];
    printf("Sgenerirovannie srednemesyachnie temperaturi\n");
    //генирация температур
    for (int i = 0; i < 4; i++) {
        printf("%-10s | ", islands[i]);
        for (int j = 0; j < 12; j++) {
            temp[i][j] = random_temp(min_t[i], max_t[i]);
            printf("%5.1f ", temp[i][j]);
        }
        printf("\n");
    }
    double max_temp = -100.0;
    int best_island = 0;
    printf("Srednegodovaya temperatura po ostrovam:\n");
    for (int i = 0; i < 4; i++) {
        double sred_temp = sred_znach(temp[i]);
        printf("%-10s : %.2f \n", islands[i], sred_temp);
        if (sred_temp > max_temp) {
            max_temp = sred_temp;
            best_island = i;
        }
    }
    printf("Maximalnaya srednegodovaya temperatura na ostrove: %s (%.2f)\n", islands[best_island], max_temp);
    return 0;
}

// Задача 19
#include <cstdio>
#include <cstdlib>
#include <ctime>

int main() {
    srand(time(0)); 

    const int k = 5;   // морские курорты
    const int max_n = 100; 
    int n;
    
    do {
        printf("Vvedite kolichestvo let nabludeniy (ot 1 do %d): ", max_n);
        scanf("%d", &n);
        if (n < 1 || n > max_n) { 
            printf("n doljno bit v diapazone ot 1 do %d. Poprobuyte eshe raz.\n", max_n);
        }
    } while (n < 1 || n > max_n); 

    int sunny_days[k][max_n];
    double distances[k];

    printf("\n[Генерация случайных данных...]\n");

    for (int i = 0; i < k; i++) {
        // Генерируем расстояние от 100 до 5000 км
        distances[i] = rand() % 4901 + 100; 
        
        // Генерируем количество солнечных дней за каждый год (от 100 до 365)
        for (int j = 0; j < n; j++) {
            sunny_days[i][j] = rand() % 266 + 100; 
        }
    }

    // 3. Подсчет суммарного количества солнечных дней для каждого курорта
    int total_sunny[k] = {0}; 
    int max_sunny = -1;             

    for (int i = 0; i < k; i++) {
        for (int j = 0; j < n; j++) {
            total_sunny[i] += sunny_days[i][j];
        }
        // Сразу ищем максимум
        if (total_sunny[i] > max_sunny) {
            max_sunny = total_sunny[i];
        }
    }

    // 4. Поиск курорта с максимальным количеством дней и минимальным расстоянием
    int best_resort_index = -1;
    double min_distance = 9999999.0; 

    for (int i = 0; i < k; i++) {
        if (total_sunny[i] == max_sunny) {
            if (distances[i] < min_distance) {
                min_distance = distances[i];
                best_resort_index = i;
            }
        }
    }

    // 5. Вывод результатов
    printf("\n========================================\n");
    printf("Статистика по курортам:\n");
    for (int i = 0; i < k; i++) {
        printf("Курорт №%d: Расстояние = %.0f км\n", i + 1, distances[i]);
        printf("  Солнечные дни по годам: ");
        for (int j = 0; j < n; j++) {
            printf("%d ", sunny_days[i][j]);
        }
        printf("\n  Суммарно солнечных дней = %d\n\n", total_sunny[i]);
    }
    printf("========================================\n");

    printf("\nРЕЗУЛЬТАТ:\n");
    printf("Курорт с наиболее благоприятным климатом: Курорт №%d\n", best_resort_index + 1);
    printf("Суммарное количество солнечных дней: %d\n", max_sunny);
    printf("Расстояние до него: %.0f км\n", min_distance);

    return 0;
}
