double sred_znach(double months[12]) {
    double sum = 0.0;
    for (int i = 0; i < 12; i++) {
        sum += months[i];
    }
    return sum / 12.0;
}
double random_temp(double min, double max) {
    return min + (rand() / (RAND_MAX + 1.0)) * (max - min);
}
int main() {
    srand(time(0));
    const char* islands[4] = { "Kuba", "Trinidad", "Yamaika", "Gaiti" };
    double min_t[4] = { 24.0, 25.0, 23.0, 22.0 };
    double max_t[4] = { 31.0, 30.0, 29.0, 28.0 };
    double temp[4][12];
    printf("Sgenerirovannie srednemesyachnie temperaturi\n");
    //генирация температур
    for (int i = 0; i < 4; i++) {
        printf("%-10s | ", islands[i]);
        for (int j = 0; j < 12; j++) {
            temp[i][j] = random_temp(min_t[i], max_t[i]);
            printf("%5.1f ", temp[i][j]);
        }
        printf("\n");
    }
    double max_temp = -100.0;
    int best_island = 0;
    printf("Srednegodovaya temperatura po ostrovam:\n");
    for (int i = 0; i < 4; i++) {
        double sred_temp = sred_znach(temp[i]);
        printf("%-10s : %.2f \n", islands[i], sred_temp);
        if (sred_temp > max_temp) {
            max_temp = sred_temp;
            best_island = i;
        }
    }
    printf("Maximalnaya srednegodovaya temperatura na ostrove: %s (%.2f)\n", islands[best_island], max_temp);
    return 0;
}

#include <cstdio>

int main() {
    const int RESORTS = 5;   // Пять морских курортов
    const int MAX_N = 100;   // Максимально допустимое количество лет
    int n;

    // 1. Ввод и проверка N в одном цикле
    do {
        printf("Введите количество лет наблюдений (от 1 до %d): ", MAX_N);
        scanf("%d", &n);
        
        // Объединенное условие: если меньше 1 ИЛИ больше максимума
        if (n < 1 || n > MAX_N) {
            printf("Ошибка: N должно быть в диапазоне от 1 до %d. Попробуйте еще раз.\n\n", MAX_N);
        }
    } while (n < 1 || n > MAX_N); // Цикл повторяется, пока условие неверное

    // Массив для солнечных дней: 5 курортов, N лет
    // Теперь мы гарантированно знаем, что n <= MAX_N, и массив не переполнится
    int sunny_days[RESORTS][MAX_N];
    
    // Массив для расстояний до курортов
    double distances[RESORTS];

    // 2. Ввод данных
    printf("\nВведите данные по каждому курорту:\n");
    for (int i = 0; i < RESORTS; i++) {
        printf("\n--- Курорт №%d ---\n", i + 1);
        
        printf("Введите расстояние до курорта (км): ");
        scanf("%lf", &distances[i]);

        printf("Введите количество солнечных дней за каждый из %d лет через пробел:\n", n);
        for (int j = 0; j < n; j++) {
            scanf("%d", &sunny_days[i][j]);
        }
    }

    // 3. Подсчет суммарного количества солнечных дней для каждого курорта
    int total_sunny[RESORTS] = {0}; // Инициализируем нулями
    int max_sunny = -1;             // Максимальное количество дней

    for (int i = 0; i < RESORTS; i++) {
        for (int j = 0; j < n; j++) {
            total_sunny[i] += sunny_days[i][j];
        }
        // Сразу ищем максимум
        if (total_sunny[i] > max_sunny) {
            max_sunny = total_sunny[i];
        }
    }

    // 4. Поиск курорта с максимальным количеством дней и минимальным расстоянием
    int best_resort_index = -1;
    double min_distance = 9999999.0; // Ставим заведомо большое число

    for (int i = 0; i < RESORTS; i++) {
        // Если у курорта максимальное количество солнечных дней
        if (total_sunny[i] == max_sunny) {
            // Проверяем, ближе ли он, чем текущий "лучший" вариант
            if (distances[i] < min_distance) {
                min_distance = distances[i];
                best_resort_index = i;
            }
        }
    }

    // 5. Вывод результатов
    printf("\n========================================\n");
    printf("Статистика по курортам:\n");
    for (int i = 0; i < RESORTS; i++) {
        printf("Курорт №%d: Суммарно солнечных дней = %d, Расстояние = %.1f км\n", 
               i + 1, total_sunny[i], distances[i]);
    }
    printf("========================================\n");

    printf("\nРЕЗУЛЬТАТ:\n");
    printf("Курорт с наиболее благоприятным климатом: Курорт №%d\n", best_resort_index + 1);
    printf("Суммарное количество солнечных дней: %d\n", max_sunny);
    printf("Расстояние до него: %.1f км\n", min_distance);

    return 0;
}
