#define _USE_MATH_DEFINES
#include <iostream>
#include <cmath>
#include <iomanip>
#include <cstdio>
#include <stdio.h>
#define _CRT_SECURE_NO_WARNINGS
using namespace std;

int main() {
    //ЗАДАНИЕ 1
    double r;
    std::printf("r = ");
    std::scanf("%lf",&r);
    
    double C = 2 * M_PI * r;
    double S = M_PI * pow(r, 2);
    double Ss = 4 * S;
    double V = (4.0 / 3.0) * S * r;
    
    std::printf("C = %f\n", C);
    std::printf("S = %f\n", S);
    std::printf("Ss = %f\n", Ss);
    std::printf("Ss = %f\n", V);
    std::printf("\n" );

    //ЗАДАНИЕ 2
    int K;
    std::printf("K = ");
    std::scanf("%d", &K);
    
    std::printf("%ds = %dh %dm %ds\n", K, K / 3600, (K % 3600) / 60, K % 60);
    std::printf("\n");

    //ЗАДАНИЕ 3
    unsigned long long grains = ~0ULL;
    double years = grains / 7.e14;

    std::printf("t = %.0f\n", ceil(years));
    std::printf("\n");

    //ЗАДАНИЕ 4
    double a, b;
    scanf_s("%lf %lf", &a, &b);
    double y = sqrt(fabs((pow(a, pow(sin(b), 2) + cos(pow(b, 3))) + cbrt(pow(b, 2))) / pow(fabs((a * tan(b)) / (1 - exp(sqrt(a)))), 0.25)));
    printf("y = %.3f\n", y);

    //ЗАДАНИЕ 5
    int h, m;
    scanf_s("%d:%d", &h, &m);
    double a = fabs(((h % 12) * 30.0 + m * 0.5) - (m * 6.0));
    
    printf("%.1f\n", (a > 180.0) ? 360.0 - a : a);

    //ЗАДАНИЕ 6
    long long s;
    scanf_s("%lld", &s);
    long long max_s = s; // маскимальная сумма
    int best_s = 0; //лучший шаг
    int i = 0; //счетчик шпгов
    
    do
    {
        i++;
        long long t = s - 29;
        s = (t % 100) * 100 + t / 100;
        best_s = (s > max_s) ? s : best_s;
        max_s = (s > max_s) ? s : max_s;
    } while (i < 10000 && s >= 29);
    
    printf("%d\n", best_s);

    return 0;
}
