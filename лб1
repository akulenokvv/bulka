#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    //ЗАДАНИЕ 1
    double r;
    cout << "r = ";
    cin >> r;

    const double PI = 3.14159;
    cout << "C = " << 2 * PI * r << endl;
    cout << "S = " << PI * r * r << endl;
    cout << "Ss = " << 4 * PI * r * r << endl;
    cout << "V = " << (4.0 / 3.0) * PI * r * r * r << endl;
    cout << endl;

    //ЗАДАНИЕ 2
    int K;
    cout << "K = ";
    cin >> K;
    cout << K << "s = " << K / 3600 << "h " << (K % 3600) / 60 << "m " << K % 60 << "s" << endl;
    cout << endl;

    //ЗАДАНИЕ 3
    unsigned long long grains = 0;
    for (int i = 0; i < 64; i++) grains += (unsigned long long)pow(2, i);
    double years = grains / (70.0 * 1e7);
    cout << "N = " << grains << endl;
    cout << "t = " << years << " (" << ceil(years) << ")" << endl;
    cout << endl;

    //ЗАДАНИЕ 4
    double a, b;
    cout << "a, b = ";
    cin >> a >> b;

    double y = sqrt((a * sin(b) * sin(b) + pow(cos(b), 3) + cbrt(b * b)) /
        (4 * a * tan(b) * (1 - exp(sqrt(a)))));
    cout << "y = " << y << endl;
    cout << endl;

    //ЗАДАНИЕ 5
    int h, m;
    cout << "h, m = ";
    cin >> h >> m;

    double angle = abs((h % 12) * 30 + m * 0.5 - m * 6);
    angle = min(angle, 360 - angle);
    cout << "ang = " << angle << "°" << endl;

    return 0;
}
