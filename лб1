#define _USE_MATH_DEFINES
#include <iostream>
#include <cmath>
#include <iomanip>
#include <cstdio>
#define _CRT_SECURE_NO_WARNINGS
using namespace std;

int main() {
    //ЗАДАНИЕ 1
    double r;
    std::printf("r = ");
    std::scanf("%lf",&r);
    
    double C = 2 * M_PI * r;
    double S = M_PI * pow(r, 2);
    double Ss = 4 * S;
    double V = (4.0 / 3.0) * S * r;
    
    std::printf("C = %f\n", C);
    std::printf("S = %f\n", S);
    std::printf("Ss = %f\n", Ss);
    std::printf("Ss = %f\n", V);
    std::printf("\n" );

    //ЗАДАНИЕ 2
    int K;
    std::printf("K = ");
    std::scanf("%d", &K);
    
    std::printf("%ds = %dh %dm %ds\n", K, K / 3600, (K % 3600) / 60, K % 60);
    std::printf("\n");

    //ЗАДАНИЕ 3
    unsigned long long grains = ~0ULL;
    double years = grains / 7.e14;

    std::printf("t = %.0f\n", ceil(years));
    std::printf("\n");

    //ЗАДАНИЕ 4
    double a, b;
    std::printf("a, b = ");
    std::scanf("%lf %lf", &a, &b);

    double y = sqrt((a * sin(b) * sin(b) + pow(cos(b), 3) + cbrt(b * b)) /
                    (4 * a * tan(b) * (1 - exp(sqrt(a)))));

    std::printf("y = %f\n", y);
    std::printf("\n");

    //ЗАДАНИЕ 5
    int h, m;
    scanf_s("%d:%d", &h, &m);
    double a = fabs((h * 30.0 + m * 0.5) - (m * 6.0));
    if (a > 180.0) a = 360.0 - a;
    printf("%.1f\n", a);

//ЗАДАНИЕ 6
    int rub, kop;
    scanf_s("%d %d", &rub, &kop);

    int cur = rub * 100 + kop;
    int best = cur, best_pass = 0;

    for (int pass = 1; pass <= 1000 && cur >= 29; pass++) {
        cur = ((cur - 29) % 100) * 100 + (cur - 29) / 100;
        best_pass = (cur > best) ? pass : best_pass;
        best      = (cur > best) ? cur  : best;
    }

    printf("%d %d %d\n", best_pass, best / 100, best % 100);
    


    return 0;
}
