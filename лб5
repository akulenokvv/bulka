// Задача 19
#include <cstdio>
#include <cstdlib>
#include <ctime>
#include <cmath> 

int main() {
    srand(time(0));
    const int max = 100; 
    double arr[max];
    int n;
    do {
        printf("Enter the number of elements n: ");
        scanf("%d", &n);
        if (n <= 0 || n > max) {
            printf("n should be from 1 to %d. Try again.\n", max);
        }
    } while (n <= 0 || n > max);

    printf("\nInitial array: ");
    for (int i = 0; i < n; i++) {
        arr[i] = 2.0 + (rand() / (RAND_MAX + 1.0)) * 8.0; // Генерация случайного числа от 2 до 10
        printf("%.4f ", arr[i]);
    }
    printf("\n");

    double best_number = arr[0];
    double min_distance = 1.0;   

    for (int i = 0; i < n; i++) {
        double fractional_part = fabs(arr[i] - (int)arr[i]);
        
        double current_distance;
        
        if (fractional_part > 0.5) {
            current_distance = 1.0 - fractional_part;
        } else {
            current_distance = fractional_part;
        }
        if (current_distance < min_distance) {
            min_distance = current_distance;
            best_number = arr[i];
        }
    }

    printf("\nThe number that lies closest to an integer: %.4f\n", best_number); //Число, которое лежит ближе всего к целому
    printf("Distance to the nearest integer: %.4f\n", min_distance); //Расстояние до ближайшего целого

    return 0;
}
