#include <stdio.h>

int main() {
    long long K;
    
    // Ввод с проверкой (do-while)
    do {
        printf("Enter K (K <= 10^9): ");
        scanf_s("%lld", &K);
        if (K <= 0 || K > 1000000000) {
            printf("Error. Try again.\n");
        }
    } while (K <= 0 || K > 1000000000);

    // ==========================================
    // РЕШЕНИЕ 1: С помощью цикла WHILE
    // ==========================================
    printf("Using WHILE:    ");
    for (int digit = 9; digit >= 0; digit--) {
        long long temp = K;
        while (temp > 0) {
            if (temp % 10 == digit) printf("%d", digit);
            temp /= 10;
        }
    }
    printf("\n");

    // ==========================================
    // РЕШЕНИЕ 2: С помощью цикла DO-WHILE
    // ==========================================
    printf("Using DO-WHILE: ");
    for (int digit = 9; digit >= 0; digit--) {
        long long temp = K;
        if (temp > 0) { // Защита для do-while, чтобы не сработал вхолостую на 0
            do {
                if (temp % 10 == digit) printf("%d", digit);
                temp /= 10;
            } while (temp > 0);
        }
    }
    printf("\n");

    // ==========================================
    // РЕШЕНИЕ 3: С помощью цикла FOR
    // ==========================================
    printf("Using FOR:      ");
    for (int digit = 9; digit >= 0; digit--) {
        long long temp = K;
        for (; temp > 0; temp /= 10) {
            if (temp % 10 == digit) printf("%d", digit);
        }
    }
    printf("\n");

    return 0;
}
