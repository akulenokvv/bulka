#include <stdio.h>
#include <iostream>
using namespace std;

int main() 
{
    // Задание 7
    double S;
    do 
    {
        printf("Enter S (S > 1): ");
        scarf_s("%lf", &S);
        if (S <= 1.0) 
        {
            printf("S must be greater than 1. Try again.\n");
        }
    } while (S <= 1.0);

    double sum = 0.0;
    int n = 0;

    // Цикл while
    while (sum <= S) 
    {
        n++;
        sum += (2.0 * n - 1) / n;
    }
    printf("Using while: %d\n", n);
    // Цикл do-while
    sum = 0.0;
    n = 0;
    do 
    {
        n++;
        sum += (2.0 * n - 1) / n;
    } while (sum <= S);
    printf("Using do-while: %d\n", n);
    // Цикл for
    sum = 0.0;
    n = 0;
    for (; sum <= S; ) 
    {
        n++;
        sum += (2.0 * n - 1) / n;
    }
    printf("Using for: %d\n", n);

    // задание 19
    long long k;
    double limit = pow(10, 9);
    do {
        printf("Enter k: ");
        scanf_s("%lld", &k);
        if (k <= 0 || k > limit) {
            printf("k must be a poditive integer and not exceed 10^9. Try again.\n");
        }
    } while (k <= 0 || k > limit);
    for (int i = 9; i >= 0; i--) {
        long long t = k;
        while (t > 0) {
            int d = t % 10;
            if (d == i) {
                printf("%d", i);
            }
            t = t / 10;
        }
    }
    printf("\n");

    return 0;
}
