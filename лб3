    double x, y;
    double prev_x, prev_y; // координаты предыдущей вершины
    double first_x, first_y; // координаты самой первой вершины
    printf("Enter coordinates of vertex 1: ");
    scanf_s("%lf %lf", &first_x, &first_y);
    prev_x = first_x;
    prev_y = first_y;
    int k = 0; // счетчик ребер, попадающих в диапазон

